{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.gnupg",
        "~/.aws",
        "~/.config",
        "~/.night-elves/env",
        "~/.night-elves/queue.db",
        "~/Library/Keychains",
        "~/Library/Messages"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "*.npmjs.org",
        "registry.yarnpkg.com",
        "crates.io",
        "index.crates.io",
        "static.crates.io",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "cdn.jsdelivr.net",
        "unpkg.com",
        "cdnjs.cloudflare.com",
        "bsky.social",
        "*.bsky.app",
        "bsky.network",
        "*.bsky.network",
        "*.github.com",
        "*.githubusercontent.com",
        "ghcr.io",
        "gitlab.com",
        "bitbucket.org",
        "*.pythonhosted.org",
        "pypi.python.org",
        "astral.sh",
        "proxy.golang.org",
        "sum.golang.org",
        "go.dev",
        "golang.org",
        "dl.google.com",
        "storage.googleapis.com",
        "rubygems.org",
        "index.rubygems.org",
        "repo.maven.apache.org",
        "repo1.maven.org",
        "plugins.gradle.org",
        "services.gradle.org",
        "downloads.gradle.org",
        "nodejs.org",
        "deno.land",
        "jsr.io",
        "bun.sh",
        "download.swift.org",
        "swiftpackageindex.com",
        "cdn.playwright.dev",
        "playwright.download.prss.microsoft.com",
        "huggingface.co",
        "*.huggingface.co",
        "*.hf.co",
        "fonts.googleapis.com",
        "fonts.gstatic.com",
        "*.wikipedia.org",
        "*.wikimedia.org",
        "developer.apple.com",
        "developer.mozilla.org",
        "docs.python.org",
        "stackoverflow.com",
        "*.stackexchange.com"
      ]
    }
  },
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(su *)",
      "Bash(osascript *)",
      "Bash(security *)",
      "Bash(launchctl *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(git push *)"
    ]
  }
}
