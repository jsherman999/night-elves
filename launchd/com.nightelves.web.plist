<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.nightelves.web</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string><string>-c</string>
    <string>. "$HOME/.night-elves/env"; export PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"; exec elf serve</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/YOU/.night-elves/web.log</string>
  <key>StandardErrorPath</key><string>/Users/YOU/.night-elves/web.log</string>
</dict>
</plist>
